{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExportPro",
  "identifier": "com.truxcorp.exportpro",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [
      {
        "title": "ExportPro",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Offload camera photos and videos into a dated tree",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExportX",
  "identifier": "com.truxcorp.exportx",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [
      {
        "title": "ExportX",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Offload camera photos and videos into a dated tree",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFOUY0NEQ4N0I2MjBEREQKUldUZERXSjcyRVNmL3Z6MXRkeTh4NWJzaW9vT1FJTkwxOTV1TEtoeld1R25VQVpXNTRUYlR4WXUK",
      "endpoints": [
        "https://github.com/truxcorp/exportx/releases/latest/download/latest.json"
      ]
    }
  }
}

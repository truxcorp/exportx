#!/usr/bin/env bash
# Installed as .githooks/pre-commit; `make hooks` enables it. Soft: `--no-verify` skips it.
# Secrets in the staged changes (~1 s).
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; secret scan skipped" >&2
  exit 0
fi
exec gitleaks protect --staged --no-banner --redact

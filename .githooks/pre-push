#!/usr/bin/env bash
# Installed as .githooks/pre-push; `make hooks` enables it. Soft: `--no-verify` skips it.
# The local checks from .workflow.yml (commands.lint, typecheck, unit) before a branch
# push. Pushes of only tags or deletions skip them.
set -euo pipefail

run=0
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in
    refs/tags/*) ;;
    *) [[ $local_sha =~ ^0+$ ]] || run=1 ;;   # all zeros: a deletion (SHA-1 or SHA-256)
  esac
done
[ "$run" -eq 1 ] || exit 0
# Without a C toolchain (e.g. Fedora Silverblue) cargo can't link: run them in the image.
if command -v cc >/dev/null 2>&1; then
  exec make lint typecheck test-unit
fi
exec make box T="lint typecheck test-unit"
